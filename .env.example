# ============================================================================
# LSADRA V3 — Environment Variables
# Copy this file to .env and customize for your deployment.
# ============================================================================

# ── Networking ───────────────────────────────────────────────────────────
API_PORT=8000
# React dashboard (docker compose `web` service)
WEB_PORT=8080

# ── Security ─────────────────────────────────────────────────────────────
# Runtime mode: true relaxes production boot guards (per-boot JWT secret, TLS
# optional) for LOCAL DEV ONLY. Never set true in production.
LSADRA_DEV_MODE=false
# REQUIRED outside dev mode — the server refuses to start without it, and
# refuses placeholders or anything shorter than 32 bytes. Generate your own:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LSADRA_JWT_SECRET=
# Self-service sign-up from the login page. Off by default outside dev mode;
# create the first admin with `python -m lsadra.admin_cli create-admin`.
LSADRA_ALLOW_SIGNUP=false
# TLS enforcement — defaults to TRUE outside dev mode; set false only for local
# plain-HTTP dev. Agents ship API keys, so production must be HTTPS.
LSADRA_REQUIRE_TLS=false
# Reverse-proxy IPs whose X-Forwarded-Proto may be trusted for TLS checks
# (comma-separated). Leave empty unless the API runs behind a known proxy.
LSADRA_TRUSTED_PROXY_IPS=
# CORS: browser origins allowed to call the API (comma-separated). Empty = none.
# Example for local dev SPA: http://localhost:5173,http://127.0.0.1:5173
LSADRA_CORS_ORIGINS=
# docker compose defaults this to http://localhost:8080 (the web service) when unset.
# Benchmark only (benchmarks/run_ingest_bench.py sets it): skip online detection
# on ingestion so storage and ML cost can be measured apart. Requires dev mode —
# the server refuses to start with this true outside LSADRA_DEV_MODE=true.
LSADRA_BENCH_SKIP_DETECTION=false
# Device-auth credential cache: after a device key passes bcrypt, repeat
# requests with the same key skip the verify for up to this many seconds
# (absolute from the verify; 0 disables, max 3600). The device row is still
# read on every request, and re-keying or deleting a device takes effect at
# once. Only a keyed fingerprint is kept in memory, never the key.
LSADRA_DEVICE_AUTH_CACHE_TTL_SECONDS=60
LSADRA_DEVICE_AUTH_CACHE_MAX_ENTRIES=10000

# ── Listener and TLS ─────────────────────────────────────────────────────
# The API listens on loopback unless this is set. On any other address it
# serves TLS: the cert/key below, or a self-signed certificate generated in
# data/tls/ on first boot (its fingerprint is printed and shown on Connect Device).
# LSADRA_API_HOST=127.0.0.1
# LSADRA_TLS_CERT=/path/to/cert.pem
# LSADRA_TLS_KEY=/path/to/key.pem
# Serve plain HTTP on a non-loopback address anyway (logged). docker compose
# sets this because it publishes the port on the host's loopback only.
# LSADRA_ALLOW_PLAINTEXT_LISTENER=false

# ── Accounts and sessions ────────────────────────────────────────────────
# Session length; logout, role/password change or disabling ends sessions early.
LSADRA_JWT_EXPIRATION_MINUTES=60
LSADRA_MIN_PASSWORD_LENGTH=12
# Failed logins allowed per username / per client IP within the window
LSADRA_LOGIN_MAX_FAILURES_PER_USER=5
LSADRA_LOGIN_MAX_FAILURES_PER_IP=20
LSADRA_LOGIN_FAILURE_WINDOW_SECONDS=900
# optional | required (required: admins cannot log in without an authenticator)
LSADRA_ADMIN_TOTP=optional
# Minutes a device's previous key keeps working after a key rotation
LSADRA_DEVICE_KEY_ROTATION_OVERLAP_MINUTES=10
# OpenAPI pages; default follows LSADRA_DEV_MODE
# LSADRA_EXPOSE_API_DOCS=false

# ── Data at rest ─────────────────────────────────────────────────────────
# Restrict data/ to the server's account at start-up (0700/0600, POSIX)
LSADRA_RESTRICT_DATA_PERMISSIONS=true
# Audit trail retention in days (minimum and default 365)
LSADRA_AUDIT_RETENTION_DAYS=365

# ── Detection ────────────────────────────────────────────────────────────
LSADRA_MIN_BASELINE_EVENTS=200
# Online detection runs on a background worker, never inside an ingestion
# request. This bounds how many distinct devices may wait for a detection run;
# when it is full, /api/events/batch and /raw answer 503 + Retry-After without
# storing the batch, so the agent's retry cannot duplicate events. Must be >= 1.
LSADRA_DETECTION_QUEUE_SIZE=256
# Python thread switch interval the server sets at startup, in ms (> 0, <= 100;
# CPython's own default is 5). Detection runs as CPU-bound Python in the server
# process; a short interval keeps it from delaying ingestion requests.
LSADRA_THREAD_SWITCH_INTERVAL_MS=0.5
LSADRA_PSI_DRIFT_THRESHOLD=0.2
LSADRA_FP_RATE_THRESHOLD=0.15
# Drift compares this many hours of recent events with the training reference.
LSADRA_DRIFT_WINDOW_HOURS=24

# ── Model integrity and training ─────────────────────────────────────────
# HMAC key for data/models/manifest.json. Empty = derived from LSADRA_JWT_SECRET;
# changing either makes the current models unverifiable, so they retrain.
LSADRA_MODEL_SIGNING_KEY=
LSADRA_MIN_TRAINING_EVENTS=50
LSADRA_TRAINING_MAX_EVENTS=10000
# With 2+ devices, no device supplies more than this share of a training set.
LSADRA_TRAINING_MAX_DEVICE_SHARE=0.5
LSADRA_RETRAIN_COOLDOWN_SECONDS=600
# Until a model has seen LSADRA_TRAINING_MAX_EVENTS events, retrain each time the
# stored event count grows by this factor (50 -> 100 -> 200 ...). 0 turns it off.
LSADRA_AUTO_RETRAIN_GROWTH=2.0
# A new model must still flag this share of each canary scenario's attack events.
LSADRA_CANARY_MIN_RECALL=0.5
LSADRA_CANARY_SCENARIOS=ssh_bruteforce,injection_attempts
# Phase 1 shadow scorer (ADR 0007): ECOD verdicts are logged, never alerted on.
LSADRA_SHADOW_ECOD_TARGET_FPR=0.001

# ── Optional LLM tier (M4) ───────────────────────────────────────────────
# Only a loopback endpoint is used unless this is true (then HTTPS only).
LSADRA_LLM_ALLOW_REMOTE=false
# SHA-256 of model weights you supply yourself (release pins cover the rest).
LSADRA_LLM_MODEL_SHA256=

# ── Live alerts (/ws/alerts) ─────────────────────────────────────────────
# Alerts buffered per connected client. A client that falls this far behind is
# closed with 1013 and should reconnect and backfill over REST. Must be >= 1.
LSADRA_WS_ALERT_QUEUE_SIZE=256

# ── Severity Thresholds ──────────────────────────────────────────────────
LSADRA_SEVERITY_CRITICAL=0.9
LSADRA_SEVERITY_HIGH=0.7
LSADRA_SEVERITY_MEDIUM=0.4

# ── Sigma Rules ──────────────────────────────────────────────────────────
# off | shadow | alert. Shadow (default) records Sigma matches without alerting.
LSADRA_SIGMA_MODE=shadow
# Optional path to a reviewed Sigma filter file with site-specific suppressions
LSADRA_SIGMA_SUPPRESSIONS=

# ── Entity Risk ──────────────────────────────────────────────────────────
# off | shadow | alert. Shadow (default) scores hosts and users and opens risk
# cases without alerting; alert also raises an alert when a case opens.
LSADRA_RISK_MODE=shadow
LSADRA_RISK_THRESHOLD=70
LSADRA_RISK_WINDOW_DAYS=7
LSADRA_RISK_HALF_LIFE_HOURS=24

# ── Incident Management ─────────────────────────────────────────────────
LSADRA_INCIDENT_WINDOW_MINUTES=15

# ── Device Monitoring ────────────────────────────────────────────────────
LSADRA_DEVICE_ONLINE_THRESHOLD_MINUTES=5

# ── Threat Intelligence (ADR 0004: two tiers) ────────────────────────────
# The bundled tier (signed CISA KEV + MITRE ATT&CK) needs no settings and no key.
# Everything below is the optional runtime tier, stored in intel_runtime.db.
# Keyless IP feeds to download: feodo, spamhaus_drop, tor_exits (empty = none)
LSADRA_INTEL_FEEDS=
LSADRA_INTEL_FEED_REFRESH_HOURS=12
# Optional. Lookups send the IP to AbuseIPDB. Free key: https://www.abuseipdb.com/account/api
LSADRA_ABUSEIPDB_API_KEY=
# Local geolocation file (.mmdb). Default: data/geo/. `python -m lsadra.intel
# geo-update` fetches GeoLite2 with these (free MaxMind account), else DB-IP Lite.
LSADRA_GEOIP_DB=
LSADRA_MAXMIND_ACCOUNT_ID=
LSADRA_MAXMIND_LICENSE_KEY=
# A directory with a newer signed bundle (optional; must verify to be used)
LSADRA_INTEL_BUNDLE_DIR=

# ── Data Retention ───────────────────────────────────────────────────────
# Raw events and heartbeats are kept this many days
LSADRA_RETENTION_DAYS=30
# Alerts and their rollups (5-minute metrics, drift) are kept this many days;
# never less than LSADRA_RETENTION_DAYS. Events behind a kept alert stay too.
LSADRA_ALERT_RETENTION_DAYS=365
# Cleanup runs every interval in small committed batches, pausing between them
LSADRA_RETENTION_INTERVAL_MINUTES=60
LSADRA_RETENTION_BATCH_SIZE=1000
LSADRA_RETENTION_BATCH_PAUSE_S=0.05

# ── Background Scheduler ─────────────────────────────────────────────────
# Retention, metrics, device-offline detection, correlation and health jobs
LSADRA_SCHEDULER_ENABLED=true
# Fill ip_geolocation from the local .mmdb file (no network); needs that file
LSADRA_GEO_RESOLUTION_ENABLED=false

# ── Metrics ──────────────────────────────────────────────────────────────
LSADRA_METRICS_INTERVAL_MINUTES=5

DISCORD_WEBHOOK_URL=  # your Discord webhook URL — put the real value in .env (gitignored), never here
