# ============================================================================
# LSADRA V3 — Environment Variables
# Copy this file to .env and customize for your deployment.
# ============================================================================

# ── Networking ───────────────────────────────────────────────────────────
API_PORT=8000
DASH_PORT=8501

# ── Security ─────────────────────────────────────────────────────────────
# Runtime mode: true relaxes production boot guards (per-boot JWT secret, TLS
# optional) for LOCAL DEV ONLY. Never set true in production.
LSADRA_DEV_MODE=false
# REQUIRED outside dev mode — the server refuses to start without it.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LSADRA_JWT_SECRET=changeme-in-production
# TLS enforcement — defaults to TRUE outside dev mode; set false only for local
# plain-HTTP dev. Agents ship API keys, so production must be HTTPS.
LSADRA_REQUIRE_TLS=false
# Reverse-proxy IPs whose X-Forwarded-Proto may be trusted for TLS checks
# (comma-separated). Leave empty unless the API runs behind a known proxy.
LSADRA_TRUSTED_PROXY_IPS=
# CORS: browser origins allowed to call the API (comma-separated). Empty = none.
# Example for local dev SPA: http://localhost:5173,http://127.0.0.1:5173
LSADRA_CORS_ORIGINS=
# Benchmark only (benchmarks/run_ingest_bench.py sets it): skip online detection
# on ingestion so storage and ML cost can be measured apart. Requires dev mode —
# the server refuses to start with this true outside LSADRA_DEV_MODE=true.
LSADRA_BENCH_SKIP_DETECTION=false
# Device-auth credential cache: after a device key passes bcrypt, repeat
# requests with the same key skip the verify for up to this many seconds
# (absolute from the verify; 0 disables, max 3600). The device row is still
# read on every request, and re-keying or deleting a device takes effect at
# once. Only a keyed fingerprint is kept in memory, never the key.
LSADRA_DEVICE_AUTH_CACHE_TTL_SECONDS=60
LSADRA_DEVICE_AUTH_CACHE_MAX_ENTRIES=10000

# ── TLS Certificates (when REQUIRE_TLS=true) ─────────────────────────────
# LSADRA_TLS_CERT=/path/to/cert.pem
# LSADRA_TLS_KEY=/path/to/key.pem

# ── Detection ────────────────────────────────────────────────────────────
LSADRA_MIN_BASELINE_EVENTS=200
# Online detection runs on a background worker, never inside an ingestion
# request. This bounds how many distinct devices may wait for a detection run;
# when it is full, /api/events/batch and /raw answer 503 + Retry-After without
# storing the batch, so the agent's retry cannot duplicate events. Must be >= 1.
LSADRA_DETECTION_QUEUE_SIZE=256
LSADRA_PSI_DRIFT_THRESHOLD=0.2
LSADRA_FP_RATE_THRESHOLD=0.15

# ── Severity Thresholds ──────────────────────────────────────────────────
LSADRA_SEVERITY_CRITICAL=0.9
LSADRA_SEVERITY_HIGH=0.7
LSADRA_SEVERITY_MEDIUM=0.4

# ── Incident Management ─────────────────────────────────────────────────
LSADRA_INCIDENT_WINDOW_MINUTES=15

# ── Device Monitoring ────────────────────────────────────────────────────
LSADRA_DEVICE_ONLINE_THRESHOLD_MINUTES=5

# ── Threat Intelligence ──────────────────────────────────────────────────
# Get a free API key at https://www.abuseipdb.com/account/api
LSADRA_ABUSEIPDB_API_KEY=

# ── Data Retention ───────────────────────────────────────────────────────
LSADRA_RETENTION_DAYS=30
# Cleanup runs every interval in small committed batches, pausing between them
LSADRA_RETENTION_INTERVAL_MINUTES=60
LSADRA_RETENTION_BATCH_SIZE=1000
LSADRA_RETENTION_BATCH_PAUSE_S=0.05

# ── Background Scheduler ─────────────────────────────────────────────────
# Retention, metrics, device-offline detection, correlation and health jobs
LSADRA_SCHEDULER_ENABLED=true
# IP geolocation sends observed public source IPs to ipinfo.io; opt-in only
LSADRA_GEO_RESOLUTION_ENABLED=false

# ── Metrics ──────────────────────────────────────────────────────────────
LSADRA_METRICS_INTERVAL_MINUTES=5

DISCORD_WEBHOOK_URL=  # your Discord webhook URL — put the real value in .env (gitignored), never here
